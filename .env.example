# Photo Helper API keys.
#
# Copy this file to `.env` in the repo root and fill in the key for whichever
# provider you want to use. `.env` is gitignored; this example file is not.
#
#     cp .env.example .env
#
# You only need the key for the provider selected in
# Settings -> Advanced -> Model. Leave the other blank.
#
# The key is read at build time and compiled into BuildConfig, so it ships inside
# the APK and can be extracted from it. That is fine for a demo build on your own
# device; do not ship a production key this way. Anything you paste into the
# in-app settings field overrides whatever is here.
#
# Re-run the build after changing this file — Gradle only reads it at build time.

# Anthropic (Claude). Get one at https://console.anthropic.com/settings/keys
# Used when the selected model is "Claude (Anthropic)".
ANTHROPIC_API_KEY=

# Alibaba Cloud Model Studio / DashScope (Qwen).
# Used when the selected model is "Qwen (Alibaba Cloud)".
DASHSCOPE_API_KEY=
