<?xml version="1.0" encoding="utf-8"?>
<!--
  The Helper Orb as the app mark: a ring swept with the Jarvis gradient
  (Coral -> Mango -> Sage) around the shutter dot.

  Drawn inside the 66dp adaptive-icon safe zone, centred on the 108dp canvas.
  Vector gradients need API 24+; minSdk is 31.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring: stroked circle, r=22 centred at 54,54 -> 44dp across, inside the safe zone. -->
    <path
        android:pathData="M54,32a22,22 0,1 1,0 44a22,22 0,1 1,0 -44"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="54"
                android:endX="76"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#E8887A" />
                <item android:offset="0.5" android:color="#FFB347" />
                <item android:offset="1.0" android:color="#8FBF9C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Shutter dot at the centre, the Orb's idle glyph. -->
    <path
        android:fillColor="#FFF5EB"
        android:pathData="M54,47a7,7 0,1 1,0 14a7,7 0,1 1,0 -14" />
</vector>
